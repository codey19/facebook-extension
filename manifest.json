{
    "manifest_version": 3,
    "name": "Run script automatically",
    "version": "1.0",
    "description": "Blocks Facebook from setting cookies mid-session.",
    "permissions": [
        "cookies",
        "browsingData",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "*://*.facebook.com/*",
        "*://*.fbcdn.net/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "declarative_net_request": {
        "rule_resources": [
        {
            "id": "ruleset_1",
            "enabled": true,
            "path": "rules.json"
        }
        ]
    }
}